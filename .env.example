# XpressBnB — local environment template
# Copy to `.env.local` for local dev (recommended) or `.env`:
#   cp .env.example .env.local
#
# Never commit `.env`, `.env.local`, or real keys.
# Vite exposes only `VITE_*` variables to the browser.

# --- Required (app will not start without these) ---
# Supabase project URL (Dashboard → Settings → API)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for frontend; RLS protects data)
VITE_SUPABASE_ANON_KEY=

# --- Optional (features degrade gracefully if unset) ---
# Google Maps JavaScript API — city map view & property map pins
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay public key for host subscription checkout only (starts with rzp_)
# Guest booking payments are disabled; do not add guest checkout keys here.
VITE_RAZORPAY_KEY_ID_HOST=

# ---------------------------------------------------------------------------
# Supabase Edge Functions (server-side only — set in Supabase Dashboard →
# Edge Functions → Secrets, NOT in Vite `.env` files)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_DEV_MODE=
# NOTIFICATION_DISPATCH_SECRET=
# HOST_DASHBOARD_URL=
